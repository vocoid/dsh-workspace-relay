{
  "name": "@local/dsh-workspace-relay",
  "version": "0.6.0",
  "description": "Workspace relay: ask another workspace automatically, message chosen sessions, spawn worker or overseer sessions, and forward messages with /forward.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-plugin-manager"]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.5",
    "@deepseek-ai/schemastery": "^3.19.0"
  }
}
